# Secretos — nunca, bajo ninguna circunstancia.
# Esta linea existe desde el primer commit a proposito: un secreto que entra
# al repositorio queda en la historia para siempre, y borrarlo no lo borra.
.dev.vars
.dev.vars.*
*.env
.env
.env.*

# Cloudflare
.wrangler/
.mf/

# Node
node_modules/
npm-debug.log*

# Construccion
dist/
.tsbuildinfo

# Verificacion visual — el arbol de referencia se versiona, los resultados no
capturas/resultado/
capturas/diff/

# Sistema
.DS_Store

# Temporal de herramientas/check-entorno.mjs — lleva el pid en el nombre para
# que dos corridas simultaneas no se pisen. Se borra en el finally; queda aca
# por si el proceso muere de un Ctrl-C. El patron cubre tambien el nombre sin pid
# que usaba la version anterior.
.check-entorno.*temporal.d.ts

# Nota de una corrida de mutacion que murio con un archivo mutado. La escribe
# `herramientas/mutar.mjs` antes de tocar cada archivo y la borra al restaurarlo;
# si sobrevive, la proxima corrida restaura desde ahi. Es estado de una corrida, no
# del proyecto — misma razon que el temporal de check-entorno.
herramientas/.mutacion-en-vuelo.json
