{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `cloudflare:test` no es un paquete de npm: es un modulo que existe solo
    // adentro del runtime de prueba. Sus tipos salen de aca, y sin esta linea
    // `import { env } from 'cloudflare:test'` no compila.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "pruebas-runtime/**/*.ts"]
}
