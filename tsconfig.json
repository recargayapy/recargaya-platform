{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `cloudflare:test` no es un paquete de npm: es un modulo que existe solo
    // adentro del runtime de prueba. Sus tipos salen de aca, y sin esta linea
    // `import { env } from 'cloudflare:test'` no compila.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "resolveJsonModule": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Los archivos de configuracion tambien entran. La primera version de
  // vitest.runtime.config.ts declaraba una opcion que el pool ya no acepta, y el
  // schema descarta las claves desconocidas en silencio: estaba escrita,
  // comentada, y no hacia nada. Con los configs adentro, tsc lo agarra.
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "pruebas-runtime/**/*.ts",
    "vitest.config.ts",
    "vitest.runtime.config.ts",
    "worker-configuration.d.ts"
  ]
}
